#!/usr/bin/env bash
# ctx — client context switcher v3.2.0
# https://github.com/Hei-Tech-Inc/ctx

set -uo pipefail

# ─── Locate libs ──────────────────────────────────────────────────────────────
CTX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CTX_LIB="$(cd "$CTX_BIN/../lib" 2>/dev/null && pwd || echo "$CTX_BIN")" # install.sh replaces this line when installing

[[ -f "$CTX_LIB/core.sh"       ]] || CTX_LIB="$CTX_BIN"
[[ -f "$CTX_LIB/core.sh"       ]] || { echo "ctx: cannot find lib/core.sh" >&2; exit 1; }

# shellcheck source=../lib/core.sh
source "$CTX_LIB/core.sh"
# shellcheck source=../lib/cmd_import.sh
source "$CTX_LIB/cmd_import.sh"
# shellcheck source=../lib/cmd_ops.sh
source "$CTX_LIB/cmd_ops.sh"

# A cancelled prompt (user_cancelled) signals this shell from a command
# substitution; exit with status 130 instead of dying from the signal.
trap 'exit 130' INT

# ─── Flag parsing ─────────────────────────────────────────────────────────────
CTX_DRY_RUN=0
CTX_QUIET="${CTX_QUIET:-0}" # inherited (e.g. the autoswitch hook); --quiet/-q sets 1
CTX_JSON=0
POSITIONAL=()
_ctx_passthrough=0

for arg in "$@"; do
  if [[ $_ctx_passthrough -eq 1 ]]; then
    POSITIONAL+=("$arg")
    continue
  fi
  case "$arg" in
    --)           _ctx_passthrough=1; POSITIONAL+=("$arg") ;;
    --dry-run)    CTX_DRY_RUN=1 ;;
    --quiet|-q)   CTX_QUIET=1 ;;
    --no-gum)     HAS_GUM=false; export CTX_NO_GUM=1 ;;
    --json)       CTX_JSON=1 ;;
    *)            POSITIONAL+=("$arg") ;;
  esac
done
export CTX_DRY_RUN CTX_QUIET CTX_JSON HAS_GUM
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

# ─── Help ─────────────────────────────────────────────────────────────────────
cmd_help() {
  case "${1-}" in
    setup|import|add|wizard)
      cmd_setup_help
      return 0
      ;;
  esac
  if $HAS_GUM; then
    gum style --border rounded --border-foreground 99 \
      --padding "1 3" --margin "1 0" \
      "$(gum style --bold "ctx v${CTX_VERSION}") — client context switcher" \
      "" \
      "$(gum style --faint "SETUP")" \
      "  init             Check deps, install hooks" \
      "  setup            Configure a new client profile (see: --config FILE)" \
      "  import / add     Alias for setup" \
      "" \
      "$(gum style --faint "DAILY USE")" \
      "  use  <name>      Activate a profile (--eval bash|fish: print exports for eval)" \
      "  deactivate       Clear active profile (prints eval for your shell)" \
      "  list (ls)        List all profiles" \
      "  status (st)      Active profile + live checks" \
      "  clone            git clone with GitHub host rewrite for this profile" \
      "  workdir-prompt   Print work_dir='WORK_DIR=…' when cwd is in prompt scope (for PS1)" \
      "  run [-p name] -- <cmd>  Run one command (e.g. an AI agent) with this folder's profile identity" \
      "  env [-p name]    Print the profile's identity as exports (eval; --secrets, --fish)" \
      "  agent-rules      Print or --write [file] AI agent instructions (AGENTS.md)" \
      "  mcp              Run the ctx MCP server (stdio) for AI agents; --profile NAME" \
      "  mcp install <claude|cursor>  Register the MCP server with Claude Code or Cursor" \
      "  knowledge init [name]  Create per-client knowledge notes" \
      "" \
      "$(gum style --faint "SECRETS  (Keychain or ~/.ctx/secrets)")" \
      "  secret set   <profile> <KEY>" \
      "  secret get   <profile> <KEY>" \
      "  secret list  <profile>" \
      "  secret delete <profile> <KEY>" \
      "" \
      "$(gum style --faint "MAINTENANCE")" \
      "  config [show]    Show ctx config values" \
      "  config work-root Set default client directory root" \
      "  config autoswitch-notify  on|off — [ctx] ←/→ lines (default off)" \
      "  config export    Export portable config bundle (no secrets)" \
      "  config import    Import portable config bundle" \
      "  verify [name]    One profile: live ssh -T, gh match, paths, email" \
      "  edit   <name>    Open profile in \$EDITOR" \
      "  remove <name>    Delete profile + secrets (rm, del)" \
      "  undo             Restore last backup" \
      "  install-hook     Install mise + ctx hooks into shell rc" \
      "  upgrade [--check] Re-run installer, or check for newer version" \
      "  uninstall [--purge] Remove ctx install; optional ~/.ctx wipe" \
      "  doctor           Machine-wide: tools, hooks, SSH layout, profiles" \
      "  guard [status|install|uninstall|check]  Block commits/pushes with the wrong profile identity" \
      "  completion <zsh|bash|fish>  Print shell completion script" \
      "  version          Print version (-v, --version)" \
      "  help setup       Full setup wizard + --config reference" \
      "" \
      "$(gum style --faint "FLAGS")" \
      "  --dry-run        Preview changes without writing files" \
      "  --quiet, -q      Suppress output (used by auto-switch)" \
      "  --no-gum         Force plain text prompts" \
      "  --json           Machine-readable JSON (list, status)" \
      "" \
      "$(gum style --faint "SETUP FLAGS")" \
      "  --scope clone|full   Clone-only profile or full wizard" \
      "  --extend NAME        Add git/folder/cloud/secrets to existing profile" \
      "  --config FILE    Non-interactive wizard (see examples/)" \
      "  -y / --yes       With --config: skip final confirmation prompt" \
      "  setup --help     Same as: ctx help setup"
  else
    # BOLD/RESET hold the text \033[1m (not the escape byte); expand it for the heredoc.
    local _b _r
    _b="$(printf '%b' "$BOLD")" _r="$(printf '%b' "$RESET")"
    cat <<EOF

${_b}ctx${_r} — client context switcher v${CTX_VERSION}

${_b}SETUP${_r}
  init                  Check deps, install hooks
  setup                 Configure a new profile (optional: --config FILE -y)
  import / add          Alias for setup

${_b}DAILY USE${_r}
  use  <name>           Activate a profile (gh, SSH, AWS, Azure, GCP, kubectl)
                        --eval bash|fish prints exports; the ctx shell function evals it
  deactivate            Clear active profile from ~/.ctx/config; run eval \"\$(ctx deactivate)\"
  list (ls)             List all profiles
  status (st)           Active profile + live checks
  clone                 git clone with GitHub host rewrite (see README)
  workdir-prompt        Print work_dir='WORK_DIR=…' when cwd is in prompt scope (for PS1)
  run [-p name] -- <cmd>  Run one command (e.g. an AI agent) with this folder's profile identity
  env [-p name]         Print the profile's identity as exports (eval; --secrets, --fish)
  agent-rules [--write [file]]  Print or write AI agent instructions (default: AGENTS.md)
  mcp [--profile name]  Run the ctx MCP server (stdio) for AI agents
  mcp install <claude|cursor>  Register the MCP server with Claude Code or Cursor
  knowledge init [name] Create per-client knowledge notes

${_b}SECRETS  (macOS Keychain; Linux: ~/.ctx/secrets, 0600 — encrypt disk)${_r}
  secret set   <profile> <KEY>
  secret get   <profile> <KEY>
  secret list  <profile>
  secret delete <profile> <KEY>

${_b}MAINTENANCE${_r}
  help setup            Full setup wizard + --config reference
  config [show]         Show ctx config values
  config work-root <p>  Set default client directory root
  config autoswitch-notify <on|off>  [ctx] ←/→ messages (default off)
  config export <dir>   Export config for laptop migration (no secrets)
  config import <dir>   Import config bundle on a new machine
  verify [name]         One profile: live ssh -T, gh match, paths, email
  edit   <name>         Open profile config in \$EDITOR
  remove <name>         Delete profile + stored secrets (rm, del)
  undo                  Restore last backup
  install-hook [rc]     Install mise + ctx hooks into shell rc
  upgrade [--check]     Re-run installer, or compare to latest on main
  uninstall [--purge]   Remove ctx binary + lib; --purge deletes ~/.ctx
  doctor                Machine-wide: tools, hooks, SSH layout, all profiles
  guard [status|install|uninstall|check]  Block commits/pushes with the wrong profile identity
  completion <zsh|bash|fish> Print shell completion script
  version               Print version (-v, --version)
  help [setup]          This screen (-h, --help)

${_b}FLAGS${_r}
  --dry-run             Preview changes, write nothing
  --quiet, -q           Suppress output (auto-switch hook uses this)
  --no-gum              Force plain text prompts
  --json                Machine-readable JSON for supported commands (list, status)
  setup --scope clone   Profile + SSH host for ctx clone only
  setup --extend NAME   Add git/folder/cloud/secrets to a profile
  setup --config FILE   Non-interactive wizard (KEY=value file)
  setup -y              With --config: confirm without prompting
  setup --help          Same as: ctx help setup

${_b}SETUP CONFIG FILE${_r}
  See ${_b}examples/setup.noninteractive.conf.example${_r} in the repo.
  1. ctx setup           → wizard detects your existing keys/accounts
  2. ctx writes:
     - ~/.ctx/profiles/<name>.conf   (metadata)
     - ~/.config/git/ctx-<name>      (git identity)
     - ~/.gitconfig                  (one includeIf line, deduped)
     - ~/.ssh/ctx_config             (SSH hosts — never ~/.ssh/config)
     - ~/clients/<name>/mise.toml    (env vars + hooks, auto-loads on cd)
  3. Secrets → macOS Keychain (or ~/.ctx/secrets elsewhere), loaded by mise hooks.enter

${_b}INSTALL REQUIREMENTS${_r}
  Everything is installed by install.sh:
    mise (env/tools per dir), gum (TUI), gh (GitHub auth), git, awscli

EOF
  fi
}

# ─── Shell completions ────────────────────────────────────────────────────────
cmd_completion() {
  local shell="${1:-zsh}"
  case "$shell" in
    zsh) cat <<'ZSH'
#compdef ctx
_ctx() {
  local cmds profiles
  cmds=(
    'init:Check deps, install hooks'
    'setup:Configure a new profile'
    'import:Alias for setup'
    'add:Alias for setup'
    'use:Activate a profile'
    'deactivate:Clear active profile (shell eval)'
    'list:List all profiles'
    'ls:Alias for list'
    'status:Show active profile and live checks'
    'st:Alias for status'
    'clone:git clone with GitHub host rewrite'
    'workdir-prompt:Print WORK_DIR line when cwd is in prompt scope'
    'config:Configure ctx defaults'
    'secret:Manage profile secrets'
    'verify:Verify profile wiring'
    'edit:Open profile config in $EDITOR'
    'remove:Delete a profile'
    'rm:Alias for remove'
    'del:Alias for remove'
    'undo:Restore last backup'
    'install-hook:Install shell hooks'
    'upgrade:Update ctx via installer'
    'uninstall:Remove ctx install'
    'doctor:Health check'
    'guard:Git identity guard (status, install, uninstall, check)'
    'run:Run a command with the profile identity'
    'env:Print profile identity as exports'
    'agent-rules:Print or write AI agent instructions'
    'mcp:Run the ctx MCP server'
    'knowledge:Manage per-client knowledge notes'
    'completion:Print shell completion'
    'version:Print version'
    'help:Show help'
    '-v:Print version'
    '--version:Print version'
    '-h:Show help'
    '--help:Show help'
  )
  profiles=("${(@f)$(ctx list 2>/dev/null | grep '^  [a-z]' | awk '{print $1}')}")
  local setup_flags=(
    '--config:Non-interactive KEY=value file'
    '--scope:Profile scope (clone or full)'
    '--extend:Add to an existing profile'
    '-y:Skip final confirm'
    '--yes:Skip final confirm'
    '--help:Full setup reference'
    '-h:Full setup reference'
  )
  local help_topics=('setup:Wizard and --config reference')
  local global_flags=(
    '--dry-run:Preview without writing files'
    '--quiet:Suppress output'
    '-q:Suppress output'
    '--no-gum:Plain prompts'
    '--json:JSON output (list, status)'
  )
  case $CURRENT in
    2) _describe 'ctx flags' global_flags && _describe 'ctx commands' cmds ;;
    3)
      case ${words[2]} in
        --dry-run|--quiet|-q|--no-gum|--json) _describe 'ctx commands' cmds ;;
        use|edit|remove|rm|del|verify) _describe 'profiles' profiles ;;
        env) local fl=('-p:Profile' '--profile:Profile' '--secrets:Include secrets' '--fish:Fish syntax'); _describe 'env flags' fl ;;
        run) local fl=('-p:Profile' '--profile:Profile'); _describe 'run flags' fl ;;
        mcp) local sub=('install:Register with Claude Code or Cursor' '--profile:Serve one profile'); _describe 'mcp options' sub ;;
        knowledge) local sub=('init'); _describe 'subcommands' sub ;;
        agent-rules) local sub=('--write:Write to a file'); _describe 'agent-rules flags' sub ;;
        setup|import|add) _describe 'setup options' setup_flags ;;
        help) _describe 'help topics' help_topics ;;
        secret) local sub=('set' 'get' 'list' 'delete' 'migrate'); _describe 'subcommands' sub ;;
        config) local sub=('show' 'work-root' 'secret-provider' 'prompt-workdir-depth' 'prompt-extra-paths' 'autoswitch-notify' 'export' 'import'); _describe 'subcommands' sub ;;
        guard) local sub=('status' 'install' 'uninstall' 'remove' 'check'); _describe 'subcommands' sub ;;
        upgrade) local sub=('--check'); _describe 'upgrade flags' sub ;;
        uninstall) local sub=('--purge'); _describe 'uninstall flags' sub ;;
        completion) local sh=('zsh' 'bash' 'fish'); _describe 'shells' sh ;;
      esac ;;
    4)
      case ${words[2]} in
        secret) _describe 'profiles' profiles ;;
        setup|import|add)
          if [[ ${words[3]} == --config ]]; then
            _files
          elif [[ ${words[3]} == --scope ]]; then
            local scopes=('clone' 'full'); _describe 'scopes' scopes
          elif [[ ${words[3]} == --extend ]]; then
            _describe 'profiles' profiles
          else
            _describe 'setup options' setup_flags
          fi
          ;;
        clone)
          case ${words[3]} in
            -p|--profile) _describe 'profiles' profiles ;;
          esac
          ;;
        use) local ev=('--eval:Print shell exports for eval'); _describe 'use flags' ev ;;
        env|run) case ${words[3]} in -p|--profile) _describe 'profiles' profiles ;; esac ;;
        mcp)
          case ${words[3]} in
            install) local tg=('claude' 'cursor'); _describe 'targets' tg ;;
            --profile) _describe 'profiles' profiles ;;
          esac
          ;;
        knowledge) [[ ${words[3]} == init ]] && _describe 'profiles' profiles ;;
        agent-rules) [[ ${words[3]} == --write ]] && _files ;;
      esac
      ;;
    5)
      case ${words[2]} in
        use) [[ ${words[4]} == --eval ]] && { local sh=('bash' 'fish'); _describe 'shells' sh; } ;;
        setup|import|add) _describe 'setup options' setup_flags ;;
        secret)
          [[ ${words[3]} =~ ^(set|get|delete)$ ]] && _describe 'profiles' profiles
          ;;
      esac
      ;;
  esac
}
_ctx "$@"
ZSH
    ;;
    bash) cat <<'BASH'
_ctx_comp() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmds="init setup import add use deactivate list ls status st clone workdir-prompt config secret verify edit remove rm del undo install-hook upgrade uninstall doctor guard run env agent-rules mcp knowledge completion version help"
  local profiles; profiles=$(ctx list 2>/dev/null | grep '^  [a-z]' | awk '{print $1}' | tr '\n' ' ')
  local w1="${COMP_WORDS[1]-}"
  # ctx list|status [--json]
  if [[ "$w1" =~ ^(list|ls|status|st)$ && "$prev" == "$w1" ]]; then
    COMPREPLY=($(compgen -W "--json" -- "$cur"))
    return
  fi
  # ctx setup [--config FILE] [-y|--yes]
  if [[ "$w1" =~ ^(setup|import|add)$ ]]; then
    if [[ "$prev" == "--config" ]]; then
      COMPREPLY=($(compgen -f -- "$cur"))
      return
    fi
    if [[ "$prev" == "--scope" ]]; then
      COMPREPLY=($(compgen -W "clone full" -- "$cur"))
      return
    fi
    if [[ "$prev" == "--extend" ]]; then
      COMPREPLY=($(compgen -W "$profiles" -- "$cur"))
      return
    fi
    COMPREPLY=($(compgen -W "--config --scope --extend -y --yes --help -h" -- "$cur"))
    return
  fi
  if [[ "$prev" == "help" ]]; then
    COMPREPLY=($(compgen -W "setup" -- "$cur"))
    return
  fi
  case "$prev" in
    use|edit|remove|rm|del|verify) COMPREPLY=($(compgen -W "$profiles" -- "$cur")) ;;
    env) COMPREPLY=($(compgen -W "-p --profile --secrets --fish" -- "$cur")) ;;
    run) COMPREPLY=($(compgen -W "-p --profile" -- "$cur")) ;;
    mcp) COMPREPLY=($(compgen -W "install --profile" -- "$cur")) ;;
    install) [[ "$w1" == mcp ]] && COMPREPLY=($(compgen -W "claude cursor" -- "$cur")) ;;
    knowledge) COMPREPLY=($(compgen -W "init" -- "$cur")) ;;
    init) [[ "$w1" == knowledge ]] && COMPREPLY=($(compgen -W "$profiles" -- "$cur")) ;;
    agent-rules) COMPREPLY=($(compgen -W "--write" -- "$cur")) ;;
    --write) [[ "$w1" == agent-rules ]] && COMPREPLY=($(compgen -f -- "$cur")) ;;
    -p|--profile) [[ "$w1" =~ ^(env|run|mcp)$ ]] && COMPREPLY=($(compgen -W "$profiles" -- "$cur")) ;;
    clone) COMPREPLY=($(compgen -W "-p --profile" -- "$cur")) ;;
    secret) COMPREPLY=($(compgen -W "set get list delete migrate" -- "$cur")) ;;
    config) COMPREPLY=($(compgen -W "show work-root secret-provider prompt-workdir-depth prompt-extra-paths autoswitch-notify export import" -- "$cur")) ;;
    guard) COMPREPLY=($(compgen -W "status install uninstall remove check" -- "$cur")) ;;
    upgrade) COMPREPLY=($(compgen -W "--check" -- "$cur")) ;;
    uninstall) COMPREPLY=($(compgen -W "--purge" -- "$cur")) ;;
    completion) COMPREPLY=($(compgen -W "zsh bash fish" -- "$cur")) ;;
    ctx) COMPREPLY=($(compgen -W "$cmds --dry-run --quiet -q --no-gum --json -v --version -h --help" -- "$cur")) ;;
  esac
  if [[ ${COMP_WORDS[1]} == clone && ${COMP_WORDS[COMP_CWORD-2]} == @(-p|--profile) ]]; then
    COMPREPLY=($(compgen -W "$profiles" -- "$cur"))
  fi
  if [[ ${COMP_WORDS[1]} == use ]]; then
    [[ $COMP_CWORD -eq 3 ]] && COMPREPLY=($(compgen -W "--eval" -- "$cur"))
    [[ "$prev" == --eval ]] && COMPREPLY=($(compgen -W "bash fish" -- "$cur"))
  fi
  if [[ ${COMP_WORDS[1]} == secret && ${COMP_WORDS[COMP_CWORD-1]} =~ ^(set|get|delete)$ ]]; then
    COMPREPLY=($(compgen -W "$profiles" -- "$cur"))
  fi
}
complete -F _ctx_comp ctx
BASH
    ;;
    fish) cat <<'FISH'
function __fish_ctx_profiles
    ctx list 2>/dev/null | awk '/^  [a-z]/ {print $1}'
end

complete -c ctx -f

complete -c ctx -n '__fish_use_subcommand' -l json -d 'JSON output (list, status)'
complete -c ctx -n '__fish_use_subcommand' -l dry-run -d 'Preview without writing files'
complete -c ctx -n '__fish_use_subcommand' -s q -l quiet -d 'Suppress output'
complete -c ctx -n '__fish_use_subcommand' -l no-gum -d 'Plain prompts'
complete -c ctx -n '__fish_use_subcommand' -s v -l version -d 'Print version'
complete -c ctx -n '__fish_use_subcommand' -s h -l help -d 'Show help'

complete -c ctx -n '__fish_use_subcommand' -a 'init setup import add use deactivate list ls status st clone workdir-prompt config secret verify edit remove rm del undo install-hook upgrade uninstall doctor guard run env agent-rules mcp knowledge completion version help'

complete -c ctx -n '__fish_seen_subcommand_from ctx help' -a 'setup' -d 'Wizard and --config reference'
complete -c ctx -n '__fish_seen_subcommand_from ctx guard' -a 'status install uninstall remove check'

complete -c ctx -n '__fish_seen_subcommand_from ctx use' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx use' -l eval -d 'Print shell exports for eval' -x -a 'fish bash'
complete -c ctx -n '__fish_seen_subcommand_from ctx edit' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx remove rm del' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx verify' -a '(__fish_ctx_profiles)'

complete -c ctx -n '__fish_seen_subcommand_from ctx env' -s p -l profile -d 'Profile' -x -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx env' -l secrets -d 'Include secrets'
complete -c ctx -n '__fish_seen_subcommand_from ctx env' -l fish -d 'Fish syntax'
complete -c ctx -n '__fish_seen_subcommand_from ctx run' -s p -l profile -d 'Profile' -x -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx mcp' -a 'install' -d 'Register with Claude Code or Cursor'
complete -c ctx -n '__fish_seen_subcommand_from ctx mcp' -l profile -d 'Serve one profile' -x -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from mcp; and __fish_seen_subcommand_from install' -a 'claude cursor'
complete -c ctx -n '__fish_seen_subcommand_from ctx knowledge' -a 'init'
complete -c ctx -n '__fish_seen_subcommand_from knowledge; and __fish_seen_subcommand_from init' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx agent-rules' -l write -d 'Write to a file (default AGENTS.md)' -r

complete -c ctx -n '__fish_seen_subcommand_from ctx secret' -a 'set get list delete migrate'
complete -c ctx -n '__fish_seen_subcommand_from ctx secret set' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx secret get' -a '(__fish_ctx_profiles)'
complete -c ctx -n '__fish_seen_subcommand_from ctx secret delete' -a '(__fish_ctx_profiles)'

complete -c ctx -n '__fish_seen_subcommand_from ctx config' -a 'show work-root secret-provider prompt-workdir-depth prompt-extra-paths autoswitch-notify export import'
complete -c ctx -n '__fish_seen_subcommand_from ctx upgrade' -a '--check'
complete -c ctx -n '__fish_seen_subcommand_from ctx uninstall' -a '--purge'
complete -c ctx -n '__fish_seen_subcommand_from ctx completion' -a 'zsh bash fish'

complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add' -s y -l yes -d 'Skip final review confirm'
complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add' -s h -l help -d 'Full setup reference'
complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add' -l config -d 'Non-interactive KEY=value file' -r
complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add; and __fish_prev_arg_in --config' -f -a '(__fish_complete_path)'
complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add' -l scope -d 'Profile scope' -x -a 'clone full'
complete -c ctx -n '__fish_seen_subcommand_from ctx setup import add' -l extend -d 'Add to an existing profile' -x -a '(__fish_ctx_profiles)'

complete -c ctx -n '__fish_seen_subcommand_from ctx list ls' -l json -d 'JSON output'
complete -c ctx -n '__fish_seen_subcommand_from ctx status st' -l json -d 'JSON output'

complete -c ctx -n '__fish_seen_subcommand_from ctx clone' -s p -l profile -d 'Profile' -a '(__fish_ctx_profiles)'
FISH
    ;;
    *) die "Unknown shell: $shell. Supported: zsh, bash, fish" ;;
  esac
}

# ─── ctx-core (Go) ────────────────────────────────────────────────────────────
# Print the path of the ctx-core binary. CTX_CORE_BIN, when set, wins and must exist.
_ctx_core_bin() {
  if [[ -n "${CTX_CORE_BIN:-}" ]]; then
    [[ -x "$CTX_CORE_BIN" ]] || return 1
    printf '%s\n' "$CTX_CORE_BIN"
    return 0
  fi
  local c
  for c in "$CTX_BIN/ctx-core" "$CTX_LIB/ctx-core"; do
    if [[ -x "$c" ]]; then printf '%s\n' "$c"; return 0; fi
  done
  command -v ctx-core 2>/dev/null
}

_ctx_core_exec() {
  local bin
  bin="$(_ctx_core_bin)" || {
    echo "ctx-core not found — reinstall ctx (install.sh) or run: go build -o bin/ctx-core ./cmd/ctx-core" >&2
    exit 1
  }
  exec "$bin" "$@"
}

# Run a command in ctx-core when it is installed, CTX_CORE is not "off", and the
# binary says it implements the command (`ctx-core implements <cmd> [args…]`;
# it sees every argument, e.g. setup decides from --config FILE and --yes).
# Once handed over there is no fallback: ctx-core's exit code is final.
# Returns 1 (caller runs Bash) otherwise.
_ctx_core_forward() {
  [[ "${CTX_CORE:-}" == "off" ]] && return 1
  local bin
  bin="$(_ctx_core_bin)" || return 1
  [[ -x "$bin" ]] || return 1
  export CTX_VERSION CTX_DIR CTX_LIB
  CTX_BIN_PATH="$CTX_BIN/ctx"
  export CTX_BIN_PATH
  "$bin" implements "$@" >/dev/null 2>&1 || return 1
  exec "$bin" "$@"
}

# ─── Dispatch ─────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    init)
      _ctx_core_forward init
      cmd_init
      ;;
    setup|import|add)
      _ctx_core_forward setup "$@" # every shape, --extend NAME included
      cmd_import "$@"
      ;;
    use)
      _ctx_core_forward use "$@" # always (quiet and non-quiet)
      cmd_use "$@"
      ;;
    deactivate)
      _ctx_core_forward deactivate "$@"
      cmd_deactivate "$@"
      ;;
    list|ls)
      if [[ "$CTX_JSON" == 1 ]]; then _ctx_core_forward list --json; else _ctx_core_forward list; fi
      cmd_list
      ;;
    status|st)
      if [[ "$CTX_JSON" == 1 ]]; then _ctx_core_forward status --json; else _ctx_core_forward status; fi
      cmd_status
      ;;
    clone)
      _ctx_core_forward clone "$@"
      cmd_clone "$@"
      ;;
    workdir-prompt)
      _ctx_core_forward workdir-prompt "$@"
      cmd_workdir_prompt
      ;;
    config)
      _ctx_core_forward config "$@"
      cmd_config "$@"
      ;;
    secret)
      case "${1:-}" in get|list|delete|set|migrate) _ctx_core_forward secret "$@" ;; esac
      cmd_secret "$@"
      ;;
    verify)
      _ctx_core_forward verify "$@"
      cmd_verify "${1:-}"
      ;;
    edit)
      _ctx_core_forward edit "$@"
      local pname="${1:-}"
      [[ -z "$pname" ]] && die "Usage: ctx edit <profile>"
      profile_exists "$pname" || die "Profile '$pname' not found."
      # Like git: VISUAL, then EDITOR, then nano; the value may carry arguments.
      local editor="${VISUAL:-${EDITOR:-nano}}"
      sh -c "$editor \"\$@\"" sh "$CTX_PROFILES_DIR/${pname}.conf"
      ;;
    remove|rm|del)
      _ctx_core_forward remove "$@"
      cmd_remove "${1:-}"
      ;;
    undo)
      _ctx_core_forward undo "$@"
      cmd_undo
      ;;
    install-hook)
      _ctx_core_forward install-hook "$@" # Go, like Bash, reads only the first
      cmd_install_hook "${1:-}"
      ;;
    upgrade)
      _ctx_core_forward upgrade "$@"
      cmd_upgrade "$@"
      ;;
    uninstall)
      _ctx_core_forward uninstall "$@"
      cmd_uninstall "$@"
      ;;
    doctor)
      _ctx_core_forward doctor "$@"
      cmd_doctor
      ;;
    guard)
      case "${1:-}" in ""|check|status|install|uninstall|remove) _ctx_core_forward guard "$@" ;; esac
      cmd_guard "$@"
      ;;
    env)
      _ctx_core_forward env "$@"
      cmd_env "$@"
      ;;
    run)
      _ctx_core_forward run "$@"
      cmd_run "$@"
      ;;
    agent-rules)      _ctx_core_forward agent-rules "$@"; cmd_agent_rules "$@" ;;
    mcp|knowledge)    _ctx_core_exec "$cmd" "$@" ;;
    completion)
      _ctx_core_forward completion "$@"
      cmd_completion "${1:-zsh}"
      ;;
    version|-v|--version)
      _ctx_core_forward ctx-version # not "version": ctx-core's own prints "ctx-core X"
      echo "ctx version $CTX_VERSION"
      ;;
    help|-h|--help)
      _ctx_core_forward help "$@"
      cmd_help "$@"
      ;;
    *)
      error "Unknown command: $cmd"
      echo ""
      echo "  Run 'ctx help' for usage."
      echo ""
      exit 1
      ;;
  esac
}

main "$@"
